DATABASE_URL=postgres://postgres:postgres@localhost:5432/stash
RESEND_API_KEY=re_replace_me
AUTH_SECRET=replace_with_a_cryptographically_secure_secret
APP_URL=http://localhost:3000
MCP_AUTH_ISSUER=http://localhost:4000
# Development-only loopback authorization server. Its issuer must exactly match
# MCP_AUTH_ISSUER. Add public clients here or use a Client ID Metadata Document.
# Never add a client secret. DCR is an opt-in legacy compatibility mode.
LOCAL_AUTH_ISSUER=http://localhost:4000
LOCAL_AUTH_HOST=127.0.0.1
LOCAL_AUTH_PORT=4000
LOCAL_AUTH_CLIENTS_JSON=[]
LOCAL_AUTH_ALLOW_DCR=false
EMAIL_FROM=Stash <onboarding@resend.dev>
AI_GATEWAY_API_KEY=replace_with_your_vercel_ai_gateway_key
AI_MODEL=openai/gpt-5.4-mini
